# Default: ignore everything in this workspace folder
*

# Publish only documentation deliverables
!.gitignore
!README.md
!docs/
!docs/**
!docs-repo-overlay/
!docs-repo-overlay/**

# Re-ignore OS, editor, and build artifacts even inside allowlisted paths
.DS_Store
.idea/
.vscode/
node_modules/
.venv/
*.log
*.tmp
.~lock.*
